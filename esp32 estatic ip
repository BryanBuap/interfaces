                    } else {    
                        currentLine = "";
                    }
                } else if (c != '\r') {  
                    currentLine += c;     
                }

                if (currentLine.endsWith("GET /getPWMValue")) {
                    int pwmValue = analogRead(pwmPin);
                    client.println(pwmValue);
                    client.println();
                    break;
                }

                if (currentLine.startsWith("GET /setPWM?value=")) {
                    int index = currentLine.indexOf('=') + 1;
                    String pwmString = currentLine.substring(index);
                    pwmString.trim();
                    PWM_VAL = pwmString.toInt();
                    Serial.print("PWM value set to: ");
                    Serial.println(PWM_VAL);
                }

                if (currentLine.endsWith("GET /H1")) cobra = 1;
                if (currentLine.endsWith("GET /L1")) cobra = 0;            
                if (currentLine.endsWith("GET /H2")) xd = 1;
                if (currentLine.endsWith("GET /L2")) xd = 0;              

                if (cobra == 1) ledcWrite(canalPWM, PWM_VAL);
                else if (cobra == 0) ledcWrite(canalPWM, PWM_OFF);
                
                if (xd == 1) ledcWrite(canalPWM2, PWM_VAL);
                else if (xd == 0) ledcWrite(canalPWM2, PWM_OFF);
            }
        }
        client.stop();
        Serial.println("Client Disconnected.");
    }
}
