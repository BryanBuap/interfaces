#include <WiFi.h>

const char* ssid = "Totalplay-90A1";
const char* password = "90A1EB45YSDUBBV6";
int PWM_VAL = 255;
int PWM_OFF = 0;
int LED1 = 16;
int LED2 = 17;
int frecuencia = 5000;
int canalPWM = 12;
int canalPWM2 = 9;
int resolucionPWM = 8;
int cobra = 0;
int xd = 0;
int pwmPin = 34;

WiFiServer server(80);

void setup() {
    Serial.begin(115200);
    
    ledcSetup(canalPWM, frecuencia, resolucionPWM);
    ledcAttachPin(LED1, canalPWM);

    ledcSetup(canalPWM2, frecuencia, resolucionPWM);
    ledcAttachPin(LED2, canalPWM2);

    delay(10);

    Serial.println();
    Serial.print("Connecting to ");
    Serial.println(ssid);

    WiFi.begin(ssid, password);

    while (WiFi.status() != WL_CONNECTED) {
        delay(500);
        Serial.print(".");
    }

    Serial.println("\nWiFi connected.");
    Serial.println("IP address: ");
    Serial.println(WiFi.localIP());
    
    server.begin();
}

